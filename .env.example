# Environment Configuration Example
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
# For SQLite (default, local development):
DATABASE_URL=sqlite:///blood_bank.db

# For PostgreSQL (cloud deployment):
# DATABASE_URL=postgresql://username:password@host:5432/blood_bank_db

# Admin Setup (used only during first-run initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Seed Data
SEED_DATABASE=false

# Debug
DEBUG=false

# Demo Mode - hide demo accounts on login page when false
DEMO_MODE=true

# SLA Response Thresholds (minutes)
SLA_CRITICAL_MINUTES=15
SLA_URGENT_MINUTES=60
SLA_ROUTINE_MINUTES=1440

# Escalation Radius (km) - notify blood banks within this distance
ESCALATION_RADIUS_KM=100.0

# Login Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Optional SMTP Email Configuration
# Email notifications are disabled if any of these are not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cloudbloodbank.org
SMTP_TLS=true