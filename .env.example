# Environment Configuration Example
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
# For SQLite (default, local development):
DATABASE_URL=sqlite:///blood_bank.db

# For PostgreSQL (cloud deployment):
# DATABASE_URL=postgresql://username:password@host:5432/blood_bank_db

# Admin Setup (used only during first-run initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Seed Data
SEED_DATABASE=false

# Debug
DEBUG=false
