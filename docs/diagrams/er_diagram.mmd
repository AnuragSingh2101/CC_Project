        string urgency "routine|urgent|critical"
        string status "pending|matched|fulfilled|cancelled"
        datetime required_by
        string notes
        datetime created_at
        datetime updated_at
    }

    RESERVATIONS {
        int id PK
        int request_id FK
        int inventory_lot_id FK
        int units_reserved
        string status "active|released|fulfilled"
        datetime created_at
        datetime updated_at
    }

    AUDIT_LOGS {
        int id PK
        int user_id FK
        string action
        string entity_type
        int entity_id
        string details
        datetime created_at
    }

